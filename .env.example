# AI Task Management Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskagent
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/taskagent

# Redis (for caching and background jobs)
REDIS_URL=redis://localhost:6379/0

# API Settings
CORS_ORIGINS=["http://localhost:3000"]

# Authentication Settings
JWT_SECRET_KEY=your-secret-key-here-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Agent Settings
DEFAULT_MODEL=gpt-4o
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# Memory Settings
HOT_MEMORY_MAX_TOKENS=1000
WARM_MEMORY_MAX_ITEMS=50
CONTEXT_WINDOW_TURNS=10

# Skills Settings
SKILL_TIMEOUT_MS=30000
MAX_CONCURRENT_SKILLS=5

# Approval Settings
AUTO_APPROVE_INTERNAL=true
REQUIRE_APPROVAL_EXTERNAL=true

# Sandbox Settings (for future use)
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=512

# OpenAI API (required for agent functionality)
OPENAI_API_KEY=your-openai-api-key-here

# Email - SMTP (choose SMTP or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Email - SendGrid (alternative to SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# SMS - Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Push Notifications - Firebase
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id
